{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",

  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],

    "module": "CommonJS",
    "moduleResolution": "Node",

    "allowJs": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "declarationMap": false,
    "noEmitOnError": true
  }
}
